{
  "name": "supaplate",
  "private": true,
  "type": "module",
  "version": "1.0",
  "scripts": {
    "prebuild": "npm run typecheck",
    "build": "react-router build",
    "build:collaboration": "tsc -p collaboration/tsconfig.json",
    "build:vercel": "VERCEL=1 VERCEL_ENV=production npm run build",
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "typecheck:collaboration": "tsc -p collaboration/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:typegen": "test -n \"$SUPABASE_PROJECT_REF\" || (echo 'Set SUPABASE_PROJECT_REF before generating database types.' >&2; exit 1); supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" > database.types.ts",
    "test:e2e": "playwright test",
    "test:e2e:drawing:production": "playwright test e2e/drawing-collaboration.spec.ts --project=chromium",
    "test:e2e:drawing-workspace:production": "playwright test e2e/drawing-workspace.spec.ts --project=chromium",
    "test:e2e:drawing-workspace-p2:production": "playwright test e2e/drawing-workspace-p2.spec.ts --project=chromium",
    "test:e2e:drawing-workspace-p3:production": "playwright test e2e/drawing-workspace-p3.spec.ts --project=chromium",
    "test:e2e:drawing-workspace-p4:local": "node scripts/run-drawing-p4-functional.mjs",
    "test:e2e:drawing-workspace-p4:performance": "P4_RELEASE_PRODUCTION_BUILD=1 playwright test e2e/drawing-workspace-p4-release.spec.ts --config=playwright.p4-release.config.ts --project=chromium --workers=1",
    "test:e2e:drawing-workspace-p4:production": "playwright test e2e/drawing-workspace-p4-production.spec.ts --project=chromium --workers=1",
    "test:e2e:drawing-workspace-p5:dev-lifecycle": "playwright test e2e/drawing-workspace-p5.spec.ts --config=playwright.p5-dev.config.ts --project=chromium --workers=1 --grep \"source swap during the pending web-ifc import\"",
    "test:e2e:drawing-workspace-p5:local": "P5_RELEASE_PRODUCTION_BUILD=1 playwright test e2e/drawing-workspace-p5.spec.ts e2e/drawing-workspace-p5-release.spec.ts --config=playwright.p5-release.config.ts --project=chromium --workers=1 --grep-invert \"source swap during the pending web-ifc import\"",
    "test:e2e:drawing-workspace-p5:production": "playwright test e2e/drawing-workspace-p5-production.spec.ts --project=chromium --workers=1",
    "release:drawing-workspace-p4:local": "node scripts/run-drawing-workspace-p4-release.mjs local",
    "release:drawing-workspace-p4:production": "node scripts/run-drawing-workspace-p4-release.mjs production",
    "release:drawing-workspace-p5:local": "node scripts/run-drawing-workspace-p5-release.mjs local",
    "release:drawing-workspace-p5:production": "node scripts/run-drawing-workspace-p5-release.mjs production",
    "smoke:drawing-collaboration:production": "playwright test e2e/drawing-collaboration-service-smoke.spec.ts --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:drawing-workspace": "node --test tests/drawing-workspace-*.test.mjs tests/drawing-fixture-cleanup.test.mjs",
    "test:ifc": "node tests/run-ifc-geometry-smoke.mjs",
    "test:public": "node --test tests/public-site-contract.test.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,json,css,md,mdx}\""
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^1.12.0",
    "@hocuspocus/provider": "4.6.0",
    "@hocuspocus/server": "4.6.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@sentry/browser": "10.70.0",
    "@sentry/react-router": "10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/og": "^0.6.5",
    "@vercel/react-router": "1.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-fetch-backend": "^6.0.0",
    "i18next-fs-backend": "2.6.7",
    "i18next-http-backend": "3.0.6",
    "i18next-resources-to-backend": "^1.2.1",
    "input-otp": "^1.4.2",
    "isbot": "^5.1.17",
    "jose": "6.2.10",
    "konva": "10.3.1",
    "lucide-react": "^0.482.0",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-konva": "19.2.5",
    "react-router": "7.18.2",
    "react-turnstile": "^1.1.4",
    "remix-i18next": "^7.1.0",
    "remix-themes": "^2.0.4",
    "resend": "^4.2.0",
    "satori": "^0.12.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "web-ifc": "0.0.77",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.19.0",
    "@types/nprogress": "^0.2.3",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.185.4",
    "drizzle-kit": "0.31.10",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-router-devtools": "^1.1.0",
    "tailwindcss": "^4.0.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
