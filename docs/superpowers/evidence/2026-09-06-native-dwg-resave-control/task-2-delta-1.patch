+create table public.lukas_drawing_native_dwg_resave_jobs (
+  id uuid primary key default extensions.gen_random_uuid(),
+  project_id uuid not null references public.lukas_qto_projects(id) on delete cascade,
+  requested_by uuid not null, request_id uuid not null,
+  scope jsonb not null, source jsonb not null, attestation jsonb not null,
+  resaver_image_id text not null check(resaver_image_id ~ '^sha256:[0-9a-f]{64}$'),
+  status text not null check(status in ('queued','processing','retry_wait','cancel_requested','cancelled','no_changes','failed')),
+  attempt_count integer not null default 0 check(attempt_count between 0 and 3),
+  lease_token uuid, lease_expires_at timestamptz,
+  next_attempt_at timestamptz not null default pg_catalog.clock_timestamp(),
+  failure_code text check(failure_code in ('source_unavailable','source_mismatch','resaver_failed','output_invalid','worker_interrupted','authority_revoked')),
+  created_at timestamptz not null default pg_catalog.clock_timestamp(),
+  unique(requested_by,request_id), unique(id,project_id),
+  check((status='no_changes')=(attestation->'request'='null'::jsonb)),
+  check(status<>'no_changes' or attempt_count=0)
+);
+create table public.lukas_drawing_native_dwg_resave_attempts (
+  job_id uuid not null, project_id uuid not null references public.lukas_qto_projects(id) on delete cascade,
+  attempt_number integer not null check(attempt_number between 1 and 3),
+  lease_token uuid not null unique, started_at timestamptz not null, lease_expires_at timestamptz not null,
+  outcome text check(outcome in ('retry_wait','failed','expired','cancelled')), finished_at timestamptz,
+  failure_code text check(failure_code in ('source_unavailable','source_mismatch','resaver_failed','output_invalid','worker_interrupted','authority_revoked')),
+  primary key(job_id,attempt_number),
+  foreign key(job_id,project_id) references public.lukas_drawing_native_dwg_resave_jobs(id,project_id) on delete cascade,
+  check((outcome is null)=(finished_at is null))
+);
+create index drawing_resave_claim_idx on public.lukas_drawing_native_dwg_resave_jobs(resaver_image_id,created_at,id)
+  where status in ('queued','retry_wait','processing','cancel_requested');
+create index drawing_resave_project_idx on public.lukas_drawing_native_dwg_resave_jobs(project_id,status);
+create index drawing_resave_attempt_project_idx on public.lukas_drawing_native_dwg_resave_attempts(project_id);
+create index drawing_resave_attempt_job_project_idx on public.lukas_drawing_native_dwg_resave_attempts(job_id,project_id);
