<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RevitVersion 하나로 TFM / 참조 DLL / 조건부 컴파일 상수가 전부 갈립니다.
    저장소 루트 빌드: dotnet build src/THEKIE.Qto/THEKIE.Qto.csproj -c Release -p:RevitVersion=2022
                      dotnet build src/THEKIE.Qto/THEKIE.Qto.csproj -c Release -p:RevitVersion=2026
    전체 빌드는 deploy\build-all.bat 사용.
  -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <IsRevitStubBuild Condition="'$(IsRevitStubBuild)' == ''">false</IsRevitStubBuild>

    <!-- Revit 2017은 .NET Framework 4.6, 2022~2024는 4.8, 2025부터 .NET 8 -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(RevitVersion)' == '2017'">net46</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(RevitVersion)' &gt;= 2025">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(RevitVersion)' &lt; 2025">net48</TargetFramework>

    <AssemblyName>THEKIE.Qto</AssemblyName>
    <RootNamespace>THEKIE.Qto</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>

    <!-- 소스에 한글이 있으므로 BOM 포함 UTF-8 저장 필수 (README 참고) -->
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>

    <!-- Revit이 자체 로딩하므로 종속 DLL 복사 금지 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\build\$(Configuration)\$(RevitVersion)\</OutputPath>
  </PropertyGroup>

  <!--
    Revit API 참조.
    기본은 로컬 설치 경로 참조. Revit이 설치되지 않은 빌드 머신에서는
    NuGet 패키지(예: Nice3point.Revit.Api.RevitAPI)로 교체하십시오.
    [검증필요] 패키지명/버전은 사용 전 nuget.org에서 확인할 것.
  -->
  <PropertyGroup>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitApiDir>
    <OutputPath Condition="'$(IsRevitStubBuild)' == 'true'">..\..\build\stub\$(Configuration)\$(RevitVersion)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core의 CSV 수식 주입 중화 계약을 manifest에서도 그대로 재사용한다. -->
    <Compile Include="..\THEKIE.Qto.Core\Csv.cs" Link="Core\Csv.cs" />
    <Compile Include="..\THEKIE.Qto.Core\ElementQuantityLedger.cs" Link="Core\ElementQuantityLedger.cs" />
    <Compile Include="..\THEKIE.Qto.Core\StructuralQuantity.cs" Link="Core\StructuralQuantity.cs" />
    <Compile Include="..\THEKIE.Qto\Core\RevitExtractionScope.cs" Link="Core\RevitExtractionScope.cs" />
    <Compile Include="..\THEKIE.Qto.Core\FormworkTakeoff.cs" Link="Core\FormworkTakeoff.cs" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Revit 2017's net46 reference assemblies for SDK-style builds. This is compile-time only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net46'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net46" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CheckRevitApi" BeforeTargets="BeforeBuild">
    <Error Condition="'$(RevitVersion)' != '2017' and '$(RevitVersion)' != '2022' and '$(RevitVersion)' != '2023' and '$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025' and '$(RevitVersion)' != '2026'"
           Text="Unsupported RevitVersion $(RevitVersion). Supported versions: 2017, 2022, 2023, 2024, 2025, 2026." />
    <Error Condition="'$(IsRevitStubBuild)' != 'true' and '$(RevitVersion)' == '2017' and '$(TargetFramework)' != 'net46'"
           Text="Production Revit 2017 builds must target net46, not $(TargetFramework)." />
    <Error Condition="'$(IsRevitStubBuild)' != 'true' and ('$(RevitVersion)' == '2022' or '$(RevitVersion)' == '2023' or '$(RevitVersion)' == '2024') and '$(TargetFramework)' != 'net48'"
           Text="Production Revit $(RevitVersion) builds must target net48, not $(TargetFramework)." />
    <Error Condition="'$(IsRevitStubBuild)' != 'true' and ('$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026') and '$(TargetFramework)' != 'net8.0-windows'"
           Text="Production Revit $(RevitVersion) builds must target net8.0-windows, not $(TargetFramework)." />
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPI.dll')"
           Text="RevitAPI.dll not found at $(RevitApiDir). Set -p:RevitApiDir=... or switch to NuGet references." />
    <Error Condition="!Exists('$(RevitApiDir)\RevitAPIUI.dll')"
           Text="RevitAPIUI.dll not found at $(RevitApiDir). Set -p:RevitApiDir=... or switch to NuGet references." />
  </Target>

  <Target Name="InvalidateProductionBuildMarker" BeforeTargets="CheckRevitApi"
          Condition="'$(Configuration)' == 'Release' and '$(IsRevitStubBuild)' != 'true'">
    <Delete Files="$(OutputPath)THEKIE.Qto.build.ok" />
  </Target>

  <Target Name="MarkSuccessfulProductionBuild" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(IsRevitStubBuild)' != 'true'">
    <WriteLinesToFile File="$(OutputPath)THEKIE.Qto.build.ok"
                      Lines="RevitVersion=$(RevitVersion);TargetFramework=$(TargetFramework);IsRevitStubBuild=$(IsRevitStubBuild);RevitApiDir=$(RevitApiDir)"
                      Overwrite="true" />
  </Target>

</Project>
